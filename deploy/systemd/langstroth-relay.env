# /etc/langstroth-relay/env: settings for deploy/systemd/langstroth-relay.service.
# Example values only. Keep the file mode 0640, owned by root. Every setting
# is in docs/reference.md; deploy/compose/langstroth-relay/.env.example has a
# commented list of the common ones, including the community limits.

# Listen address. Keep it on loopback and terminate TLS in a reverse proxy on
# this host (clients require https://), for example Caddy:
#   relay.example.com { reverse_proxy 127.0.0.1:8443 }
LANGSTROTH_RELAY_ADDR=127.0.0.1:8443
# The proxy above connects from loopback: read the client address from it.
LANGSTROTH_RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Storage. Unset: memory plus a snapshot in /var/lib/langstroth-relay (one
# instance). Set: Postgres (recommended for a team). With it, also refuse to
# start if it ever goes missing.
# DATABASE_URL=postgres://relay:<password>@db.internal.example:5432/relay?sslmode=verify-full
# LANGSTROTH_RELAY_REQUIRE_DB=1
# Memory store only: cap the bytes it holds (writes past it answer 507).
LANGSTROTH_RELAY_MAX_STORE_BYTES=268435456

# Access (optional; open by default). Set the issuer PUBLIC key only; the
# private key stays where tokens are minted (langstroth-relay keygen / issue).
# LANGSTROTH_RELAY_TOKEN_PUBKEY=<64 hex chars>
# LANGSTROTH_RELAY_WORKSPACE_SCOPE=claims
# LANGSTROTH_RELAY_METRICS_TOKEN=<random string>

# Phone tunnel: off (default), open or allowlist.
# LANGSTROTH_RELAY_TUNNEL=open

# Let the Go runtime collect garbage before a small host runs out of memory.
# GOMEMLIMIT=800MiB
