# Settings for deploy/compose/langstroth-relay. Copy to .env and edit.
# Everything here is an example: no real secret or hostname. Keep .env out of
# version control (chmod 600 .env). Every relay setting is documented in
# docs/reference.md; docs/deploy.md walks through a deployment.

# ── Compose (read by compose.yaml itself) ─────────────────────────────────────
# Postgres password (compose.yaml only). It goes into a URL: letters and
# digits only. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-random-hex-string
# Public name of the relay, for Caddy (--profile tls). Point its DNS here.
RELAY_DOMAIN=relay.example.com
# Where the relay's port 8443 is published on the host. Keep loopback when a
# proxy on this host (or Caddy) terminates TLS; clients require https://.
RELAY_BIND=127.0.0.1
# The compose network. The relay trusts forwarding headers only from this
# range (Caddy, or a proxy on the host via the network gateway). Change it
# only if it collides with a network you already use.
RELAY_SUBNET=172.30.53.0/24

# ── Access (optional; the relay is open by default) ───────────────────────────
# The relay URL is not a secret, and everything stored is end-to-end
# encrypted. To admit only people you issue tokens to, generate an issuer
# keypair OFF this host (langstroth-relay keygen), keep the private key there,
# and set only the public key here. Mint tokens with langstroth-relay issue.
# LANGSTROTH_RELAY_TOKEN_PUBKEY=<64 hex chars from keygen>
# Confine each signed token to the workspaces in its claim: off, claims, strict.
# LANGSTROTH_RELAY_WORKSPACE_SCOPE=claims
# Or a coarse static allowlist of bearer tokens, comma-separated.
# LANGSTROTH_RELAY_ACCESS_TOKENS=<token-1>,<token-2>
# Relay-managed team membership (roster, claim, invites, join).
# LANGSTROTH_RELAY_MEMBERSHIP=1
# Bearer token required on /metrics (else /metrics is open).
# LANGSTROTH_RELAY_METRICS_TOKEN=<random string>

# ── Features ──────────────────────────────────────────────────────────────────
# Encrypted attachments: on (default) or off.
# LANGSTROTH_RELAY_BLOBS=on
# Phone tunnel (Ligus iPhone app <-> ligus serve): off (default), open, allowlist.
# LANGSTROTH_RELAY_TUNNEL=open
# LANGSTROTH_RELAY_TUNNEL_HOSTS=<host_id>,<host_id>
# Push for the tunnel needs an APNs key; mount it as a file and set the
# LANGSTROTH_RELAY_APNS_* settings (docs/reference.md, "Push from your own relay").

# ── Memory store (compose.standalone.yaml) ────────────────────────────────────
# Cap on bytes the in-memory store holds (writes past it answer 507).
# LANGSTROTH_RELAY_MAX_STORE_BYTES=268435456

# ── Community limits (a relay anyone may use) ─────────────────────────────────
# All off by default. Quotas refuse with 507 (never evict), rates answer 429.
# Values below suit one small machine (1 GB RAM, 10 GB Postgres disk); see
# docs/deploy.md, "A relay for the public".
# LANGSTROTH_RELAY_ROOM_MAX_BYTES=67108864
# LANGSTROTH_RELAY_ROOM_MAX_ENVELOPES=200000
# LANGSTROTH_RELAY_MAX_TOTAL_ROOM_BYTES=3758096384
# LANGSTROTH_RELAY_MAX_ROOMS_PER_CLIENT=50
# LANGSTROTH_RELAY_MAX_ROOMS=100000
# LANGSTROTH_RELAY_ROOM_RETENTION_DAYS=180
# LANGSTROTH_RELAY_IP_RATE=20
# LANGSTROTH_RELAY_IP_BURST=200
# LANGSTROTH_RELAY_ROOM_RATE=50
# LANGSTROTH_RELAY_ROOM_BURST=500
# LANGSTROTH_RELAY_BLOB_TOTAL_MAX_BYTES=1610612736
# LANGSTROTH_RELAY_MAX_CONTACT_BYTES=536870912
# LANGSTROTH_RELAY_MAX_SSE=1200
# LANGSTROTH_RELAY_MAX_INFLIGHT_PER_CLIENT=32
# LANGSTROTH_RELAY_BLOB_MAX_INFLIGHT=4
# LANGSTROTH_RELAY_BLOB_DOWNLOAD_INFLIGHT=4
# LANGSTROTH_RELAY_TUNNEL_PUSH_RATE=0.2
# LANGSTROTH_RELAY_TUNNEL_PUSH_BURST=5
# LANGSTROTH_RELAY_TUNNEL_PUSH_PER_DAY=500
# GOMEMLIMIT=800MiB
